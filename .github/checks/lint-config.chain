diff --git a/scripts/tests/check-write-paths.test.sh b/scripts/tests/check-write-paths.test.sh
new file mode 100755
index 0000000..7da2cb8
--- /dev/null
+++ b/scripts/tests/check-write-paths.test.sh
@@ -0,0 +1,129 @@
+#!/usr/bin/env bash
+# Known-bad / known-good cases for scripts/guards/check-write-paths.sh.
+# Each case builds a throwaway git repo: a base commit (agent map + decision
+# log), then PR commits, then runs the check and compares the exit code.
+#
+# Usage: scripts/tests/check-write-paths.test.sh
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+CHECK="$ROOT/scripts/guards/check-write-paths.sh"
+
+pass=0
+failed=0
+work="$(mktemp -d)"
+trap 'rm -rf "$work"' EXIT
+
+BASE_MAP='agents:
+  - id: A50
+    unit: verification
+    status: active
+  - id: A52
+    unit: verification
+    status: ended
+  - id: A10
+    unit: code
+    status: active
+'
+
+BASE_LOG='# Log
+| D47 | Verification owns its path. | decided | A50 |
+| D90 | A10 may add verification/second-impl/ outputs. | decided | A10 |
+| D91 | Unrelated decision about data/. | decided | A9 |
+'
+
+# new_repo [with_map=1]: fresh repo with a base commit; echoes nothing.
+new_repo() {
+  local with_map="${1:-1}"
+  rm -rf "$work/repo"
+  mkdir -p "$work/repo/docs/decisions" "$work/repo/verification"
+  cd "$work/repo"
+  git init -q -b main
+  git config user.email t@t
+  git config user.name t
+  printf '%s' "$BASE_LOG" >docs/decisions/log.md
+  echo seed >verification/README.md
+  echo seed >README.md
+  if [ "$with_map" = 1 ]; then printf '%s' "$BASE_MAP" >docs/agents.yaml; fi
+  git add -A
+  git commit -qm "base"
+  BASE="$(git rev-parse HEAD)"
+}
+
+# commit <message> <file> [content]: write file and commit with message.
+commit() {
+  mkdir -p "$(dirname "$2")"
+  printf '%s\n' "${3:-change}" >>"$2"
+  git add -A
+  git commit -qm "$1"
+}
+
+# expect <name> <exit code> [body]
+expect() {
+  local name="$1" want="$2" body="${3:-}" got=0
+  printf '%s' "$body" >"$work/body"
+  "$CHECK" --base "$BASE" --head HEAD --body-file "$work/body" >"$work/out" 2>&1 || got=$?
+  if [ "$got" = "$want" ]; then
+    pass=$((pass + 1)); echo "ok   $name"
+  else
+    failed=$((failed + 1)); echo "FAIL $name (want $want, got $got)"; sed 's/^/     /' "$work/out"
+  fi
+  cd "$ROOT"
+}
+
+T=$'\n\nAgent: '
+
+new_repo; commit "v${T}A50" verification/x.md
+expect "verification agent writes verification/" 0
+
+new_repo; commit "v${T}A10" verification/x.md
+expect "non-verification agent writes verification/" 1
+
+new_repo; commit "v${T}A10" verification/second-impl/out.csv
+expect "cited decision names parent folder" 0 "Per D90."
+
+new_repo; commit "v${T}A10" verification/x.md
+expect "cited decision does not name path" 1 "Per D91."
+
+new_repo; commit "v${T}A10" README.md
+expect "D69: cited decision missing on base" 1 "Per D999."
+
+new_repo; commit "v" verification/x.md
+expect "no trailer on verification/" 1
+
+new_repo; commit "v" README.md
+expect "no trailer elsewhere is a warning" 0
+
+new_repo; commit "v${T}A77" README.md
+expect "unknown agent elsewhere is a warning" 0
+
+new_repo; commit "v${T}A50" README.md
+expect "verification agent outside its path (R2)" 1
+
+new_repo; commit "v${T}A52" verification/x.md
+expect "ended agent (R4)" 1
+
+new_repo; commit "v${T}A50" docs/agents.yaml $'  - id: A64\n    unit: verification\n    status: active'
+expect "verification agent adds a verification row" 0
+
+new_repo; commit "v${T}A10" docs/agents.yaml $'  - id: A64\n    unit: verification\n    status: active'
+expect "non-verification agent adds a verification row (R3)" 1
+
+new_repo; commit "v${T}A50" docs/agents.yaml $'  - id: A64\n    unit: code\n    status: active'
+expect "verification agent adds a code row (R2)" 1
+
+new_repo; commit "v${T}A10" docs/agents.yaml $'  - id: A64\n    unit: code\n    status: active'
+expect "non-verification agent adds a code row" 0
+
+new_repo 0; commit "v${T}A7" docs/agents.yaml "$BASE_MAP"
+expect "bootstrap: map absent on base" 0
+
+new_repo; commit $'squash (#9)\n\n* first\n\n  Agent: A50\n\n* second\n\n  Agent: A10' verification/x.md
+expect "squash message: one non-verification agent fails" 1
+
+new_repo; commit $'squash (#9)\n\n* first\n\n  Agent: A50' verification/x.md
+expect "squash message: indented trailer is parsed" 0
+
+echo ""
+echo "check-write-paths tests: $pass passed, $failed failed"
+[ "$failed" = 0 ]
diff --git a/scripts/tests/registers.test.sh b/scripts/tests/registers.test.sh
new file mode 100755
index 0000000..856422c
--- /dev/null
+++ b/scripts/tests/registers.test.sh
@@ -0,0 +1,183 @@
+#!/usr/bin/env bash
+# Known-bad / known-good cases for scripts/registers.py.
+# Each case builds a throwaway root with issues/ and research/obstacles/.
+#
+# Usage: scripts/tests/registers.test.sh
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+REG="$ROOT/scripts/registers.py"
+
+pass=0
+failed=0
+work="$(mktemp -d)"
+trap 'rm -rf "$work"' EXIT
+R="$work/root"
+
+fresh() { rm -rf "$R"; mkdir -p "$R/issues" "$R/research/obstacles"; }
+
+# issue <id> <severity> <target> <status> [extra line]
+issue() {
+  {
+    echo "id: $1"
+    echo "title: test issue $1"
+    echo "severity: $2"
+    echo "target: $3"
+    echo "opened: 2026-10-01"
+    echo "status: $4"
+    echo "owner: A50"
+    [ -z "${5:-}" ] || echo "$5"
+  } >"$R/issues/$1.yaml"
+}
+
+# obstacle <id> <date> <check> [status]
+obstacle() {
+  {
+    echo "id: $1"
+    echo "title: test obstacle $1"
+    echo "owner: A10"
+    echo "exit: the check passes"
+    echo "check: $3"
+    echo "date: $2"
+    echo "status: ${4:-open}"
+  } >"$R/research/obstacles/$1.yaml"
+}
+
+# expect <name> <want exit> [grep pattern] -- <registers.py args...>
+expect() {
+  local name="$1" want="$2" pat="$3" got=0
+  shift 4
+  python3 "$REG" --root "$R" "$@" >"$work/out" 2>&1 || got=$?
+  if [ "$got" = "$want" ] && { [ -z "$pat" ] || grep -qE "$pat" "$work/out"; }; then
+    pass=$((pass + 1)); echo "ok   $name"
+  else
+    failed=$((failed + 1)); echo "FAIL $name (want $want, got $got${pat:+, pattern: $pat})"
+    sed 's/^/     /' "$work/out"
+  fi
+}
+
+# --- issues + gate -------------------------------------------------------------
+
+fresh; issue s1-split S1 research/metric-v0/split.yaml open
+expect "open S1 on the target blocks" 1 "BLOCKED by issues/s1-split.yaml" -- gate research/metric-v0/split.yaml
+
+fresh; issue s2-folder S2 research/metric-v0/ open
+expect "open S2 on a parent folder blocks" 1 "BLOCKED" -- gate research/metric-v0/split.yaml
+
+fresh; issue s1-file S1 interface/templates/base.html open
+expect "open S1 inside a published folder blocks" 1 "BLOCKED" -- gate interface/
+
+fresh; issue s1-sealed S1 SEAL-metric-v0 open
+expect "open S1 on a sealed id blocks" 1 "BLOCKED" -- gate SEAL-metric-v0
+
+fresh; issue s3-minor S3 research/metric-v0/ open
+expect "open S3 does not block" 0 "no open S1/S2" -- gate research/metric-v0/split.yaml
+
+fresh; issue s1-done S1 research/metric-v0/ closed "closed: 2026-10-03"
+expect "closed S1 does not block" 0 "" -- gate research/metric-v0/split.yaml
+
+fresh; issue s1-other S1 data/ open
+expect "open S1 elsewhere does not block" 0 "" -- gate research/metric-v0/split.yaml
+
+fresh; issue s1-prefix S1 research/metric open
+expect "name prefix is not a parent folder" 0 "" -- gate research/metric-v0/split.yaml
+
+fresh; issue bad S1 x open; sed -i.bak '/^severity:/d' "$R/issues/bad.yaml"; rm -f "$R/issues/bad.yaml.bak"
+expect "issue missing field fails the schema" 1 "missing field: severity" -- issues
+
+fresh; issue bad S1 x open; sed -i.bak '/^severity:/d' "$R/issues/bad.yaml"; rm -f "$R/issues/bad.yaml.bak"
+expect "invalid register refuses the gate" 1 "register invalid" -- gate x
+
+fresh; issue bad S4 x open
+expect "unknown severity fails" 1 "severity" -- issues
+
+fresh; issue bad S2 x closed
+expect "closed without a closed date fails" 1 "closed: YYYY-MM-DD" -- issues
+
+fresh; issue wrong-name S2 x open; mv "$R/issues/wrong-name.yaml" "$R/issues/other.yaml"
+expect "id differs from file name fails" 1 "id must equal" -- issues
+
+fresh; issue ok-1 S2 x open
+expect "valid issue passes the schema" 0 "1 valid, 0 error" -- issues
+
+# --- obstacles -----------------------------------------------------------------
+
+fresh; obstacle o1-metric 2026-10-10 "false"
+expect "past date + failing check is reported" 1 "\[FAILED\] Obstacle o1-metric" -- obstacles --today 2026-10-20
+
+fresh; obstacle o1-metric 2026-10-10 "false"
+expect "report names owner and lateness" 1 "10 day\(s\) past" -- obstacles --today 2026-10-20
+
+fresh; obstacle o2-ok 2026-10-10 "true"
+expect "past date + passing check is not reported" 0 "nothing missed" -- obstacles --today 2026-10-20
+
+fresh; obstacle o3-later 2026-12-01 "false"
+expect "future date is not run" 0 "nothing missed" -- obstacles --today 2026-10-20
+
+fresh; obstacle o4-met 2026-10-10 "false" met
+expect "met obstacle is not re-run" 0 "" -- obstacles --today 2026-10-20
+
+fresh; obstacle o5-job 2026-10-10 "job:Runs (manifests · re-run)"
+expect "due CI-job check is reported for a manual look" 1 "NEEDS CHECK" -- obstacles --today 2026-10-20
+
+fresh; obstacle o6-bad 2026-10-10 "true"; sed -i.bak '/^owner:/d' "$R/research/obstacles/o6-bad.yaml"; rm -f "$R/research/obstacles/o6-bad.yaml.bak"
+expect "obstacle missing field fails" 1 "missing field: owner" -- obstacles --schema-only
+
+fresh; obstacle o7-nodate 2026-10-10 "true"; sed -i.bak 's/^date:.*/date: month 6/' "$R/research/obstacles/o7-nodate.yaml"; rm -f "$R/research/obstacles/o7-nodate.yaml.bak"
+expect "relative date ('month 6') fails" 1 "date: YYYY-MM-DD" -- obstacles --schema-only
+
+fresh; obstacle o8-judge 2026-10-10 "judge:A50"
+expect "judge check without evidence fails" 1 "evidence" -- obstacles --schema-only
+
+fresh; obstacle o9-ok 2026-10-10 "true"
+touch "$work/before"
+expect "check runs without writing to the repo" 0 "" -- obstacles --today 2026-10-20
+if [ -n "$(find "$R" -newer "$work/before" -type f)" ]; then
+  failed=$((failed + 1)); echo "FAIL obstacles wrote into the root"
+fi
+
+# --- unowned rows and milestones -------------------------------------------
+
+# set_line <file> <key> <value>: replace or append a key.
+set_line() {
+  if grep -q "^$2:" "$1"; then sed -i.bak "s|^$2:.*|$2: $3|" "$1"; rm -f "$1.bak"
+  else echo "$2: $3" >>"$1"; fi
+}
+F() { echo "$R/research/obstacles/$1.yaml"; }
+
+fresh; obstacle u1 null "judge:A50" unowned; set_line "$(F u1)" evidence verification/evidence/u1.md
+expect "date null + unowned is valid" 0 "1 valid, 0 error" -- obstacles --schema-only
+
+fresh; obstacle u1 null "judge:A50" unowned; set_line "$(F u1)" evidence verification/evidence/u1.md
+expect "unowned row is reported daily" 1 "\[UNOWNED\] Obstacle u1" -- obstacles --today 2026-10-20
+
+fresh; obstacle u2 null "true" open
+expect "date null with status open fails" 1 "date: null only with status: unowned" -- obstacles --schema-only
+
+fresh; obstacle u3 2027-01-20 "true" unowned
+expect "unowned with a real date fails" 1 "unowned only with date: null" -- obstacles --schema-only
+
+fresh; obstacle m1 2027-07-20 "true"; set_line "$(F m1)" milestone "sim v0 sealed"; set_line "$(F m1)" milestone_date 2026-10-15
+expect "due milestone is reported before the exit date" 1 "\[MILESTONE DUE\] Obstacle m1" -- obstacles --today 2026-10-20
+
+fresh; obstacle m2 2027-07-20 "true"; set_line "$(F m2)" milestone "sim v0 sealed"; set_line "$(F m2)" milestone_date 2026-10-15; set_line "$(F m2)" milestone_status met
+expect "met milestone is not reported" 0 "nothing missed" -- obstacles --today 2026-10-20
+
+fresh; obstacle m3 2027-07-20 "true"; set_line "$(F m3)" milestone "sim v0 sealed"
+expect "milestone without milestone_date fails" 1 "go together" -- obstacles --schema-only
+
+fresh; obstacle m4 2027-07-20 "true"; set_line "$(F m4)" milestone "x"; set_line "$(F m4)" milestone_date "month 4"
+expect "relative milestone_date fails" 1 "milestone_date: YYYY-MM-DD" -- obstacles --schema-only
+
+# --- unit sub-folders (<= 8 entries per folder) ---------------------------------
+
+fresh; obstacle s1 2026-10-10 "false"; mkdir -p "$R/research/obstacles/platform"; mv "$(F s1)" "$R/research/obstacles/platform/"
+expect "row in a unit sub-folder is loaded and reported" 1 "research/obstacles/platform/s1.yaml" -- obstacles --today 2026-10-20
+
+fresh; obstacle d1 2027-01-01 "true"; mkdir -p "$R/research/obstacles/a" "$R/research/obstacles/b"
+cp "$(F d1)" "$R/research/obstacles/a/"; mv "$(F d1)" "$R/research/obstacles/b/"
+expect "same id in two sub-folders fails" 1 "duplicate id d1" -- obstacles --schema-only
+
+echo ""
+echo "registers tests: $pass passed, $failed failed"
+[ "$failed" = 0 ]
diff --git a/scripts/tests/runs.test.sh b/scripts/tests/runs.test.sh
new file mode 100755
index 0000000..1d91c31
--- /dev/null
+++ b/scripts/tests/runs.test.sh
@@ -0,0 +1,111 @@
+#!/usr/bin/env bash
+# Known-bad / known-good cases for scripts/runs.py and scripts/local/build-lock.sh.
+# Manifest cases copy research/runs/toy-gompertz-v0 into a temp folder of the
+# same name, break one thing, and expect check/rerun to fail.
+#
+# Usage: scripts/tests/runs.test.sh
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+RUNS="$ROOT/scripts/runs.py"
+LOCK="$ROOT/scripts/local/build-lock.sh"
+SRC="$ROOT/research/runs/toy-gompertz-v0"
+
+pass=0
+failed=0
+work="$(mktemp -d)"
+trap 'rm -rf "$work"' EXIT
+
+ok()  { pass=$((pass + 1)); echo "ok   $1"; }
+bad() { failed=$((failed + 1)); echo "FAIL $1"; sed 's/^/     /' "$work/out"; }
+
+# fresh: copy the toy run; echoes the manifest path.
+fresh() {
+  rm -rf "$work/runs"
+  mkdir -p "$work/runs"
+  cp -R "$SRC" "$work/runs/"
+  echo "$work/runs/toy-gompertz-v0/manifest.yaml"
+}
+
+# expect <name> <want exit> <check|rerun> <manifest>
+expect() {
+  local got=0
+  (cd "$ROOT" && python3 "$RUNS" "$3" "$4") >"$work/out" 2>&1 || got=$?
+  if [ "$got" = "$2" ]; then ok "$1"; else bad "$1 (want $2, got $got)"; fi
+}
+
+# set_field <manifest> <key> <value>
+set_field() { sed -i.bak -E "s|^($2):.*|\\1: $3|" "$1" && rm -f "$1.bak"; }
+
+# --- manifests ---------------------------------------------------------------
+
+m="$(fresh)"; expect "good manifest: check" 0 check "$m"
+m="$(fresh)"; expect "good manifest: rerun reproduces outputs" 0 rerun "$m"
+
+m="$(fresh)"; set_field "$m" seed 43
+expect "changed seed: rerun output mismatch" 1 rerun "$m"
+
+m="$(fresh)"; sed -i.bak 's/^b: .*/b: 0.009/' "$(dirname "$m")/params.yaml"; rm -f "$(dirname "$m")/params.yaml.bak"
+expect "changed param: params hash mismatch" 1 check "$m"
+
+m="$(fresh)"; sed -i.bak '/^seed:/d' "$m"; rm -f "$m.bak"
+expect "missing field (seed)" 1 check "$m"
+
+m="$(fresh)"; sed -i.bak '/^toolchain:/,/^outputs:/{/^toolchain:/!{/^outputs:/!d;};}' "$m"; rm -f "$m.bak"
+expect "empty toolchain map" 1 check "$m"
+
+m="$(fresh)"; echo "tampered,1" >>"$(dirname "$m")/output.csv"
+expect "committed output edited after the run" 1 check "$m" # still passes schema...
+m="$(fresh)"; echo "tampered,1" >>"$(dirname "$m")/output.csv"
+expect "committed output edited: rerun catches it" 1 rerun "$m"
+
+m="$(fresh)"; sed -i.bak -E 's|(gompertz_toy.py: )[0-9a-f]{6}|\1000000|' "$m"; rm -f "$m.bak"
+expect "code hash mismatch" 1 check "$m"
+
+m="$(fresh)"; echo "extra: 1" >>"$m"
+expect "unknown field" 1 check "$m"
+
+m="$(fresh)"; set_field "$m" command 'python3 x.py --seed 42'
+expect "command without {seed}" 1 check "$m"
+
+m="$(fresh)"; set_field "$m" code_commit 1111111111111111111111111111111111111111
+expect "unknown code_commit is a warning" 0 check "$m"
+
+# --- build lock --------------------------------------------------------------
+
+export ASTRA_BUILD_LOCK_DIR="$work/lock"
+log="$work/conc.log"
+: >"$log"
+job() { echo "start" >>"$log"; sleep 1; echo "end" >>"$log"; }
+export -f job
+export log
+for _ in 1 2 3 4; do "$LOCK" bash -c job 2>/dev/null & done
+wait
+max="$(awk '/start/{c++; if (c>m) m=c} /end/{c--} END{print m}' "$log")"
+if [ "$max" -le 2 ] && [ "$(grep -c start "$log")" = 4 ]; then ok "lock: 4 jobs, at most 2 at once (max $max)"
+else echo "max=$max" >"$work/out"; bad "lock: concurrency"; fi
+
+got=0
+"$LOCK" sleep 3 2>/dev/null &
+"$LOCK" sleep 3 2>/dev/null &
+sleep 0.5
+ASTRA_BUILD_LOCK_TIMEOUT=1 "$LOCK" true >"$work/out" 2>&1 || got=$?
+wait
+if [ "$got" = 75 ]; then ok "lock: timeout exits 75"; else bad "lock: timeout (got $got)"; fi
+
+mkdir -p "$ASTRA_BUILD_LOCK_DIR/slot-1" "$ASTRA_BUILD_LOCK_DIR/slot-2"
+echo 999999 >"$ASTRA_BUILD_LOCK_DIR/slot-1/pid"
+echo 999999 >"$ASTRA_BUILD_LOCK_DIR/slot-2/pid"
+got=0
+ASTRA_BUILD_LOCK_TIMEOUT=2 "$LOCK" true >"$work/out" 2>&1 || got=$?
+if [ "$got" = 0 ]; then ok "lock: stale slot of a dead PID is reclaimed"; else bad "lock: stale reclaim (got $got)"; fi
+
+rm -rf "$ASTRA_BUILD_LOCK_DIR"/slot-*
+got=0
+"$LOCK" bash -c 'exit 7' >"$work/out" 2>&1 || got=$?
+if [ "$got" = 7 ] && [ -z "$(ls "$ASTRA_BUILD_LOCK_DIR")" ]; then ok "lock: exit code passed through, slot released"
+else bad "lock: exit/release (got $got)"; fi
+
+echo ""
+echo "runs tests: $pass passed, $failed failed"
+[ "$failed" = 0 ]
