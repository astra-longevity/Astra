           }, indent=1, sort_keys=True))
           PY
           {
-            echo "### n_sim ${N_SIM}"
+            echo "### ${STUDY}, n_sim ${N_SIM}"
             echo '```json'
             cat "$OUT/run-info.json"
             echo '```'
           } >> "$GITHUB_STEP_SUMMARY"
       - uses: actions/upload-artifact@v4
         with:
-          name: sim-joint-${{ matrix.n }}
+          name: sim-${{ inputs.study }}-${{ matrix.n }}
           path: ${{ runner.temp }}/out
           if-no-files-found: error
           retention-days: 30
