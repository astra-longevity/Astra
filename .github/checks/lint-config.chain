diff --git a/.github/workflows/lifespan.yml b/.github/workflows/lifespan.yml
new file mode 100644
index 0000000..063b439
--- /dev/null
+++ b/.github/workflows/lifespan.yml
@@ -0,0 +1,54 @@
+name: Lifespan
+
+# Runs literature/lifespan/check.rb (L1 lifespan table: row schema + test2_main).
+# Owner: A10 (Code). Requested by A2/A65 before the D115 seal.
+# No on.paths filter: the job always reports, and passes with "no lifespan
+# change" when literature/lifespan/** is untouched (safe as a required check).
+
+on:
+  pull_request:
+  merge_group:
+  push:
+    branches: [main]
+
+permissions:
+  contents: read
+
+jobs:
+  lifespan:
+    name: Lifespan (check.rb)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Detect lifespan changes
+        id: changes
+        env:
+          EVENT: ${{ github.event_name }}
+          PR_BASE: ${{ github.event.pull_request.base.sha }}
+          MQ_BASE: ${{ github.event.merge_group.base_sha }}
+          PUSH_BEFORE: ${{ github.event.before }}
+        run: |
+          case "$EVENT" in
+            pull_request) base="$PR_BASE" ;;
+            merge_group)  base="$MQ_BASE" ;;
+            *)            base="$PUSH_BEFORE" ;;
+          esac
+          if [ -z "$base" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
+            echo "Base unknown: running the check."
+            echo "run=true" >> "$GITHUB_OUTPUT"
+          elif git diff --name-only "$base" HEAD | grep -Eq '^(literature/lifespan/|\.github/workflows/lifespan\.yml$)'; then
+            echo "run=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "run=false" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: Run check.rb
+        if: steps.changes.outputs.run == 'true'
+        run: ruby literature/lifespan/check.rb
+
+      - name: No lifespan change
+        if: steps.changes.outputs.run != 'true'
+        run: 'echo "No change under literature/lifespan/ or lifespan.yml, nothing to check."'
diff --git a/.github/workflows/protection-drift.yml b/.github/workflows/protection-drift.yml
new file mode 100644
index 0000000..7f57d38
--- /dev/null
+++ b/.github/workflows/protection-drift.yml
@@ -0,0 +1,80 @@
+name: Protection drift
+
+# D52 (docs/decisions/founding-council-log.md): once a day, read the live
+# branch protection of main and the merge-queue ruleset, and compare them with
+# the payloads committed in docs/rust/. Any difference fails the job and opens
+# (or comments on) one issue titled "Protection drift".
+#
+# Read-only. Reading branch protection and rulesets needs repository
+# "Administration: read", which the default GITHUB_TOKEN does not have, so the
+# GET calls use the PROTECTION_READ_TOKEN secret, stored in the `protection`
+# environment (deployment branches: main only). GITHUB_TOKEN is only used to
+# write the issue.
+on:
+  schedule:
+    - cron: "17 6 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  issues: write
+
+concurrency:
+  group: protection-drift
+  cancel-in-progress: false
+
+env:
+  RULESET_ID: "25413974"
+  ISSUE_TITLE: "Protection drift"
+
+jobs:
+  drift:
+    name: Compare live protection with docs/rust/
+    runs-on: ubuntu-latest
+    # PROTECTION_READ_TOKEN lives in this main-only environment, not at repo
+    # level, so no workflow on another branch can read it.
+    environment: protection
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Read live settings (GET only)
+        env:
+          GH_TOKEN: ${{ secrets.PROTECTION_READ_TOKEN }}
+        run: |
+          if [ -z "$GH_TOKEN" ]; then
+            echo "::error::secret PROTECTION_READ_TOKEN is missing: cannot read live protection" > /dev/stderr
+            echo "missing-token" > drift-report.txt
+            exit 1
+          fi
+          gh api "repos/${{ github.repository }}/branches/main/protection" > live-protection.json
+          gh api "repos/${{ github.repository }}/rulesets/${RULESET_ID}" > live-ruleset.json
+
+      - name: Compare
+        run: |
+          set -o pipefail
+          scripts/guards/protection-drift.sh live-protection.json live-ruleset.json 2>&1 | tee drift-report.txt
+
+      - name: Open or update the "Protection drift" issue
+        if: failure()
+        env:
+          GH_TOKEN: ${{ github.token }}
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          {
+            echo "@bigmoostache the live branch protection or merge-queue ruleset no longer matches the payloads committed in \`docs/rust/\` (D52)."
+            echo
+            echo "Run: $RUN_URL"
+            echo
+            echo '```diff'
+            head -c 60000 drift-report.txt 2>/dev/null || echo "(no report: the check could not run, see the run log)"
+            echo '```'
+            echo
+            echo "No agent may change protection or rulesets. The president decides whether to restore the settings or to update the committed payloads by PR."
+          } > issue-body.md
+          number="$(gh issue list --repo "${{ github.repository }}" --state open --search "\"$ISSUE_TITLE\" in:title" --json number,title \
+            --jq "map(select(.title == \"$ISSUE_TITLE\")) | .[0].number // empty")"
+          if [ -n "$number" ]; then
+            gh issue comment "$number" --repo "${{ github.repository }}" --body-file issue-body.md
+          else
+            gh issue create --repo "${{ github.repository }}" --title "$ISSUE_TITLE" --body-file issue-body.md
+          fi
diff --git a/.github/workflows/registers.yml b/.github/workflows/registers.yml
new file mode 100644
index 0000000..a2fcef1
--- /dev/null
+++ b/.github/workflows/registers.yml
@@ -0,0 +1,64 @@
+name: Registers
+
+# Issue register (issues/) and obstacle register (research/obstacles/). P3,
+# charter parts 8 and 9, T8-A10-1.
+#   - On every PR / queue / push: self-tests + schema of both registers.
+#   - Daily (and on demand): run every obstacle check that is due and print an
+#     issue-ready report of missed or failing exits. The job fails when there
+#     is one, so the red run is the alarm. It never writes to the repo
+#     (contents: read, no issue creation from the job).
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+  merge_group:
+  schedule:
+    - cron: "37 6 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  schema:
+    name: Registers (schema · tests)
+    if: github.event_name != 'schedule' && github.event_name != 'workflow_dispatch'
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.13"
+
+      - name: Self-tests (known-bad issues and obstacles)
+        run: scripts/tests/registers.test.sh
+
+      - name: Issue register schema
+        run: python3 scripts/registers.py issues
+
+      - name: Obstacle register schema
+        run: python3 scripts/registers.py obstacles --schema-only
+
+  due:
+    name: Obstacles due (daily)
+    if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.13"
+
+      - name: Run due checks
+        run: |
+          set -o pipefail
+          python3 scripts/registers.py obstacles | tee "$RUNNER_TEMP/report.md"
+
+      - name: Issue-ready report
+        if: failure()
+        run: cat "$RUNNER_TEMP/report.md" >>"$GITHUB_STEP_SUMMARY"
diff --git a/.github/workflows/runs.yml b/.github/workflows/runs.yml
new file mode 100644
index 0000000..21a3324
--- /dev/null
+++ b/.github/workflows/runs.yml
@@ -0,0 +1,36 @@
+name: Runs
+
+# Re-runs every run manifest under research/runs/ and fails on any output
+# mismatch (byte-exact). Also runs the known-bad tests of the manifest tool
+# and the build lock. P2, charter part 6.
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+  merge_group:
+
+permissions:
+  contents: read
+
+jobs:
+  runs:
+    name: Runs (manifests · re-run)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.13"
+
+      - name: Self-tests (known-bad manifests, build lock)
+        run: scripts/tests/runs.test.sh
+
+      - name: Check manifests
+        run: python3 scripts/runs.py check research/runs/*/manifest.yaml
+
+      - name: Re-run manifests
+        run: python3 scripts/runs.py rerun research/runs/*/manifest.yaml
