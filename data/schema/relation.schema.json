{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra/relation.schema.json",
  "title": "Relation (directed link between two concepts)",
  "description": "File: data/relations/<id>.yaml. Reads as \"from <type> to\", e.g. genomic-instability aggravates mitochondrial-dysfunction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "from", "to", "type", "claims"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/relation_id" },
    "from": { "$ref": "common.schema.json#/$defs/slug" },
    "to": { "$ref": "common.schema.json#/$defs/slug" },
    "type": {
      "enum": ["causes", "aggravates", "inhibits", "activates", "marker_of", "treats", "prevents", "part_of", "associated_with"]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/claim_id" }
    },
    "note": { "type": "string" }
  }
}
