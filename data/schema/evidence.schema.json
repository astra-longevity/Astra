{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra/evidence.schema.json",
  "title": "Evidence (link between a claim and a source)",
  "description": "File: data/evidence/<claim>--<source file name>.yaml. One (claim, source) pair per file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim", "source", "direction"],
  "properties": {
    "claim": { "$ref": "common.schema.json#/$defs/claim_id" },
    "source": { "$ref": "common.schema.json#/$defs/source_id" },
    "direction": {
      "enum": ["supports", "contradicts", "nuances"],
      "description": "Does the source back the claim up, go against it, or add a limit to it?"
    },
    "locator": { "type": "string", "minLength": 1, "description": "Where in the source: \"Fig. 2\", \"p. 419\", \"Table 1\"." },
    "note": { "type": "string" }
  }
}
