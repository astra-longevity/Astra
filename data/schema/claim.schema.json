{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra/claim.schema.json",
  "title": "Claim (one scientific statement)",
  "description": "File: data/claims/<id>.yaml. Its sources are separate Evidence objects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "concepts", "organism", "evidence_level", "confidence", "mission"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/claim_id" },
    "statement": { "$ref": "common.schema.json#/$defs/text" },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/slug" }
    },
    "organism": {
      "$ref": "common.schema.json#/$defs/slug",
      "description": "Id of a concept with kind=organism (e.g. homo-sapiens, mus-musculus)."
    },
    "evidence_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "See data/schema/evidence-levels.yaml."
    },
    "confidence": {
      "enum": ["established", "debated", "speculative"],
      "description": "established requires at least one verified source."
    },
    "mission": { "$ref": "common.schema.json#/$defs/slug" },
    "note": { "type": "string" }
  }
}
