{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra/claim.schema.json",
  "title": "Claim (affirmation scientifique)",
  "description": "Fichier : data/claims/<id>.yaml. Ses sources sont des objets Evidence séparés.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement_fr", "concepts", "organism", "evidence_level", "confidence", "mission"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/claim_id" },
    "statement_fr": { "$ref": "common.schema.json#/$defs/text_fr" },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/slug" }
    },
    "organism": {
      "$ref": "common.schema.json#/$defs/slug",
      "description": "Id d'un concept de kind=organism (ex. homo-sapiens, mus-musculus)."
    },
    "evidence_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "Voir data/schema/evidence-levels.yaml."
    },
    "confidence": { "enum": ["solide", "débattu", "spéculatif"] },
    "mission": { "$ref": "common.schema.json#/$defs/slug" },
    "note_fr": { "type": "string" }
  }
}
