{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra/question.schema.json",
  "title": "Open question",
  "description": "File: data/questions/<id>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "concepts", "mission", "status"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/question_id" },
    "statement": { "$ref": "common.schema.json#/$defs/text" },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/slug" }
    },
    "mission": { "$ref": "common.schema.json#/$defs/slug" },
    "status": { "enum": ["open", "resolved"] },
    "resolved_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/claim_id" },
      "description": "Claims that answer the question. Required when status=resolved."
    },
    "note": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "resolved" } } },
      "then": { "required": ["resolved_by"] }
    }
  ]
}
