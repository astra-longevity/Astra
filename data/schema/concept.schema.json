{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra/concept.schema.json",
  "title": "Concept (biological notion)",
  "description": "File: data/concepts/<id>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "kind": {
      "enum": ["hallmark", "gene", "protein", "pathway", "process", "intervention", "disease", "biomarker", "organism", "cell-type", "tissue", "other"]
    },
    "name": { "$ref": "common.schema.json#/$defs/text" },
    "synonyms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "description": { "type": "string", "description": "One or two plain-English sentences." }
  }
}
