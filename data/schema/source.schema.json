{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra/source.schema.json",
  "title": "Source (publication scientifique)",
  "description": "Fichier : data/sources/<nom de fichier dérivé de l'id>.yaml (voir BUILD_SPEC.md §2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "year", "authors", "type", "status"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/source_id" },
    "title": { "$ref": "common.schema.json#/$defs/text_fr" },
    "year": { "type": "integer", "minimum": 1600, "maximum": 2100 },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[^,]+(, .+)?$" },
      "description": "Dans l'ordre de la publication, format « Nom, Prénom ». Un collectif s'écrit sans virgule."
    },
    "journal": { "type": "string", "minLength": 1, "description": "Revue ou éditeur (livres)." },
    "type": {
      "enum": ["study", "review", "trial", "meta-analysis", "book", "book-chapter", "preprint", "guideline", "other"]
    },
    "status": { "enum": ["vérifié", "à vérifier"] },
    "verified_via": { "enum": ["crossref", "pubmed", "isbn", "manual"] },
    "verified_at": { "$ref": "common.schema.json#/$defs/date" },
    "note_fr": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "vérifié" } } },
      "then": { "required": ["verified_via", "verified_at"] }
    }
  ]
}
