{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra/contradiction.schema.json",
  "title": "Contradiction between claims",
  "description": "File: data/contradictions/<id>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "claims", "mission", "explanation"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/contradiction_id" },
    "claims": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/claim_id" }
    },
    "mission": { "$ref": "common.schema.json#/$defs/slug" },
    "explanation": { "$ref": "common.schema.json#/$defs/text" },
    "status": {
      "enum": ["open", "resolved"],
      "description": "Optional. open = not yet explained; resolved = the team found why the claims disagree."
    }
  }
}
