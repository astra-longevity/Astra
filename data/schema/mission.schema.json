{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra/mission.schema.json",
  "title": "Mission (chantier de recherche)",
  "description": "Fichier : data/missions/<id>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "folder"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "title": { "$ref": "common.schema.json#/$defs/text_fr" },
    "folder": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*[^/]$",
      "description": "Dossier du dépôt, relatif à la racine, sans / final (ex. literature/aging-map)."
    },
    "summary_fr": { "type": "string" }
  }
}
